# ═══════════════════════════════════════════════════════
# StickerForge — Environment Variables
# Salin file ini menjadi .env.local untuk development
# ═══════════════════════════════════════════════════════

# Groq API Key — dapatkan gratis di https://console.groq.com
# WAJIB diisi. Jangan pernah commit nilai aslinya ke Git.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Groq yang digunakan
# Default yang direkomendasikan: llama-3.1-8b-instant
# Pilihan lain: llama-3.3-70b-versatile | mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# Vision model used to analyze uploaded character reference images.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Base URL untuk og:image dan canonical URL
# Di production: ganti dengan domain kamu
NEXT_PUBLIC_BASE_URL=https://stickerforge.vercel.app

# Local sticker image service
# Jalankan service SDXL Turbo + rembg terpisah, lalu arahkan endpoint ini ke service tersebut.
STICKER_IMAGE_API_URL=http://localhost:8000/generate-sticker
STICKER_IMAGE_API_TIMEOUT_MS=600000

# Optional local image service tuning
IMAGE_SERVICE_PORT=8000
NEXT_PORT=3000
SDXL_WIDTH=512
SDXL_HEIGHT=512
SDXL_STEPS=1
SDXL_DEVICE=auto
SDXL_DTYPE=auto
# Use a downloaded SDXL Turbo Diffusers model directory to run without HF_TOKEN.
# Example Windows path:
# SDXL_MODEL_PATH=C:\models\sdxl-turbo
# If SDXL_MODEL_PATH is not set, the service uses SDXL_MODEL_ID from Hugging Face Hub.
SDXL_MODEL_ID=stabilityai/sdxl-turbo
# Legacy FLUX_* variables are still accepted as fallback during migration.
# Default installs CUDA 12.1 PyTorch. For Intel Arc GPU, set:
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/xpu
# SDXL_DEVICE=xpu
# SDXL_DTYPE=fp16
# For CPU-only, set:
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Docker fallback uses GPU by default. Set DOCKER_GPUS=0 for CPU fallback.
# DOCKER_GPUS=all
