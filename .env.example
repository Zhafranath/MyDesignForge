# ═══════════════════════════════════════════════════════
# StickerForge — Environment Variables
# Salin file ini menjadi .env.local untuk development
# ═══════════════════════════════════════════════════════

# Groq API Key — dapatkan gratis di https://console.groq.com
# WAJIB diisi. Jangan pernah commit nilai aslinya ke Git.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Groq yang digunakan
# Pilihan: llama-3.3-70b-versatile | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Base URL untuk og:image dan canonical URL
# Di production: ganti dengan domain kamu
NEXT_PUBLIC_BASE_URL=https://stickerforge.vercel.app

# Local sticker image service
# Jalankan service FLUX.1 + rembg terpisah, lalu arahkan endpoint ini ke service tersebut.
STICKER_IMAGE_API_URL=http://localhost:8000/generate-sticker
STICKER_IMAGE_API_TIMEOUT_MS=600000

# Optional local image service tuning
IMAGE_SERVICE_PORT=8000
NEXT_PORT=3000
FLUX_WIDTH=768
FLUX_HEIGHT=768
FLUX_STEPS=4
# Default installs CUDA 12.1 PyTorch. For CPU-only, set:
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# Docker fallback uses GPU by default. Set DOCKER_GPUS=0 for CPU fallback.
# DOCKER_GPUS=all
